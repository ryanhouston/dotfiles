{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "model": "anthropic/claude-sonnet-4-6",
  "small_model": "anthropic/claude-haiku-4-5",
  "share": "manual",
  "default_agent": "plan",
  "lsp": true,
  "plugin": ["./model-pricing.ts"],
  "tools": {
    "read": true,
    "write": true,
    "edit": true,
    "grep": true,
    "glob": true,
    "list": true,
    "webfetch": true,
    "bash": true
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "aws *": "deny",
      "az *": "deny",
      "gcloud *": "deny",
      "kubectl *": "deny",
      "docker *": "ask",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "chmod +x *": "ask",
      "curl *": "allow",
      "wget *": "allow",
      "git *": "allow",
      "npm *": "allow",
      "yarn *": "allow",
      "pnpm *": "allow",
      "node *": "allow",
      "python *": "allow",
      "pip *": "allow",
      "ls": "allow",
      "pwd": "allow",
      "cat": "allow",
      "head": "allow",
      "tail": "allow"
    }
  }
}
